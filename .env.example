# Recap — environment variables
# Copy to .env and fill in. Never commit .env.

# --- LLM provider (custom, OpenAI-compatible) ---
GMI_API_KEY=replace-me

# --- TrueForge server (local Docker) ---
TF_BASE_URL=http://localhost:18790

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (Postgres in the same TrueForge container) ---
# Port 5433 is the host-side mapping of Postgres 5432 inside the container
# (see docker-compose.override.yml; 5432 is reserved for the local dev box).
DATABASE_URL=postgres://trueforge:trueforge@localhost:5433/recap

# --- Redis (rate limiting, also used by the TrueForge server) ---
# Port 6380 is the host-side mapping of Redis 6379 inside the container.
REDIS_URL=redis://localhost:6380

# --- Daytona sandbox (ephemeral per turn) ---
DAYTONA_API_KEY=replace-me

# --- Optional: GitHub MCP for the agent (paper repo access) ---
# GITHUB_TOKEN=
