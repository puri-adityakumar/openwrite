# Recap — environment variables
# Copy to .env and fill in. Never commit .env.

# --- LLM provider (GMI Cloud — Anthropic /v1/messages format) ---
# Sign in at the GMI Cloud console, create a "gmi-cloud" provider, and
# copy the API key it shows. The provider must be configured with
# API format = "Anthropic messages (/v1/messages)" so the route below
# works as written. Default model below matches the one shown in the
# provider's model list.
GMI_API_KEY=replace-me
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=MiniMaxAI/MiniMax-M3

# --- TrueForge server (local harness) ---
# No mode switch — live-only. Start with: npx @truefoundry/trueforge@latest
TRUEFORGE_BASE_URL=http://localhost:8790

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (Postgres in the same TrueForge container) ---
# Port 5433 is the host-side mapping of Postgres 5432 inside the container
# (see docker-compose.override.yml; 5432 is reserved for the local dev box).
DATABASE_URL=postgres://trueforge:trueforge@localhost:5433/recap

# --- Redis (rate limiting, also used by the TrueForge server) ---
# Port 6380 is the host-side mapping of Redis 6379 inside the container.
REDIS_URL=redis://localhost:6380

# --- Daytona sandbox (ephemeral per turn) ---
DAYTONA_API_KEY=replace-me

# --- Optional: GitHub MCP for the agent (paper repo access) ---
# GITHUB_TOKEN=
